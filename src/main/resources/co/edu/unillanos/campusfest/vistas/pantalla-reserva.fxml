<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="contenedor">
    <Label text="Reservar y Confirmar Entrada" styleClass="titulo"/>
    <Label text="Identificador del evento:"/>
    <TextField fx:id="campoEventoId" promptText="Ej. EV-01"/>
    <Label text="Identificador del estudiante:"/>
    <TextField fx:id="campoEstudianteId" promptText="Ej. 160005xxx"/>
    <HBox spacing="10">
        <Button text="Solicitar Reserva" onAction="#solicitarReserva"/>
    </HBox>
    <Label text="Código QR de la reserva:"/>
    <TextField fx:id="campoCodigoReserva" promptText="Código generado"/>
    <HBox spacing="10">
        <Button text="Confirmar Reserva" onAction="#confirmarReserva"/>
    </HBox>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje"/>
</VBox>
