<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="contenedor">
    <Label text="Editar Información del Evento" styleClass="titulo"/>
    <Label text="Identificador del evento:"/>
    <HBox spacing="10">
        <TextField fx:id="campoEventoId" promptText="Ej. EV-01"/>
        <Button text="Cargar Evento" onAction="#obtenerEvento"/>
    </HBox>
    <Label text="Nombre del evento:"/>
    <TextField fx:id="campoNombre"/>
    <Label text="Fecha y hora (YYYY-MM-DDTHH:MM):"/>
    <TextField fx:id="campoFecha" promptText="2026-11-28T19:00"/>
    <Label text="Lugar:"/>
    <TextField fx:id="campoLugar"/>
    <Label text="Aforo total:"/>
    <TextField fx:id="campoAforo"/>
    <Button text="Guardar Cambios" onAction="#guardarCambios"/>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje"/>
</VBox>
