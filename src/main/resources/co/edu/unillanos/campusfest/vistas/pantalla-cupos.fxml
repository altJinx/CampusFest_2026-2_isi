<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="contenedor">
    <Label text="Consulta de Cupos Disponibles" styleClass="titulo"/>
    <Label text="Identificador del evento:"/>
    <TextField fx:id="campoEventoId" promptText="Ej. EV-01"/>
    <Button text="Consultar Cupos" onAction="#consultar"/>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje"/>
</VBox>
